{
  "$defs": {
    "MappingProposal": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_field": {
          "title": "Source Field",
          "type": "string"
        },
        "canonical_field": {
          "title": "Canonical Field",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "accepted",
            "review"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_field",
        "canonical_field",
        "disposition",
        "hypothesis_id"
      ],
      "title": "MappingProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "recipe_id": {
      "title": "Recipe Id",
      "type": "string"
    },
    "generated_by": {
      "default": "marble-discovery-0.0.1",
      "title": "Generated By",
      "type": "string"
    },
    "mappings": {
      "items": {
        "$ref": "#/$defs/MappingProposal"
      },
      "title": "Mappings",
      "type": "array"
    },
    "entity_grains": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Entity Grains",
      "type": "object"
    },
    "resolution_policy": {
      "const": "no_merges",
      "default": "no_merges",
      "title": "Resolution Policy",
      "type": "string"
    },
    "requires_review": {
      "default": true,
      "title": "Requires Review",
      "type": "boolean"
    },
    "normalization_proposal_ids": {
      "items": {
        "type": "string"
      },
      "title": "Normalization Proposal Ids",
      "type": "array"
    }
  },
  "required": [
    "recipe_id",
    "mappings",
    "entity_grains"
  ],
  "title": "RecipeDraft",
  "type": "object"
}
