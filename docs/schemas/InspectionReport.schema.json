{
  "$defs": {
    "CanonicalPreview": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "record_key": {
          "title": "Record Key",
          "type": "string"
        },
        "canonical_fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Canonical Fields",
          "type": "object"
        },
        "unmapped_fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Unmapped Fields",
          "type": "object"
        }
      },
      "required": [
        "source_id",
        "record_key",
        "canonical_fields",
        "unmapped_fields"
      ],
      "title": "CanonicalPreview",
      "type": "object"
    },
    "Check": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "result": {
          "title": "Result",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        }
      },
      "required": [
        "name",
        "passed",
        "result"
      ],
      "title": "Check",
      "type": "object"
    },
    "ColumnProfile": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "nonempty": {
          "title": "Nonempty",
          "type": "integer"
        },
        "distinct_nonempty": {
          "title": "Distinct Nonempty",
          "type": "integer"
        },
        "completeness": {
          "title": "Completeness",
          "type": "number"
        },
        "uniqueness": {
          "title": "Uniqueness",
          "type": "number"
        },
        "sample_values": {
          "items": {
            "type": "string"
          },
          "title": "Sample Values",
          "type": "array"
        },
        "detected_pattern": {
          "title": "Detected Pattern",
          "type": "string"
        }
      },
      "required": [
        "name",
        "nonempty",
        "distinct_nonempty",
        "completeness",
        "uniqueness",
        "sample_values",
        "detected_pattern"
      ],
      "title": "ColumnProfile",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "signal": {
          "title": "Signal",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "strength": {
          "maximum": 1,
          "minimum": 0,
          "title": "Strength",
          "type": "number"
        }
      },
      "required": [
        "signal",
        "detail",
        "strength"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "field_mapping",
            "entity_grain",
            "record_match"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Field"
        },
        "left_record": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left Record"
        },
        "right_record": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right Record"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "disposition": {
          "enum": [
            "accepted",
            "review",
            "rejected"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Checks",
          "type": "array"
        },
        "model": {
          "default": "deterministic",
          "enum": [
            "deterministic",
            "ml"
          ],
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "kind",
        "source_id",
        "target",
        "score",
        "disposition",
        "evidence",
        "checks"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "MappingProposal": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_field": {
          "title": "Source Field",
          "type": "string"
        },
        "canonical_field": {
          "title": "Canonical Field",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "accepted",
            "review"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_field",
        "canonical_field",
        "disposition",
        "hypothesis_id"
      ],
      "title": "MappingProposal",
      "type": "object"
    },
    "RecipeDraft": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "recipe_id": {
          "title": "Recipe Id",
          "type": "string"
        },
        "generated_by": {
          "default": "marble-discovery-0.0.1",
          "title": "Generated By",
          "type": "string"
        },
        "mappings": {
          "items": {
            "$ref": "#/$defs/MappingProposal"
          },
          "title": "Mappings",
          "type": "array"
        },
        "entity_grains": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Entity Grains",
          "type": "object"
        },
        "resolution_policy": {
          "const": "no_merges",
          "default": "no_merges",
          "title": "Resolution Policy",
          "type": "string"
        },
        "requires_review": {
          "default": true,
          "title": "Requires Review",
          "type": "boolean"
        }
      },
      "required": [
        "recipe_id",
        "mappings",
        "entity_grains"
      ],
      "title": "RecipeDraft",
      "type": "object"
    },
    "SourceProfile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "record_count": {
          "title": "Record Count",
          "type": "integer"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnProfile"
          },
          "title": "Columns",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "uri",
        "record_count",
        "columns"
      ],
      "title": "SourceProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "source_profiles": {
      "items": {
        "$ref": "#/$defs/SourceProfile"
      },
      "title": "Source Profiles",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "recipe_draft": {
      "$ref": "#/$defs/RecipeDraft"
    },
    "canonical_preview": {
      "items": {
        "$ref": "#/$defs/CanonicalPreview"
      },
      "title": "Canonical Preview",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": true,
      "title": "Metrics",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "source_profiles",
    "hypotheses",
    "recipe_draft",
    "canonical_preview",
    "metrics"
  ],
  "title": "InspectionReport",
  "type": "object"
}
